# Site URL — required for auth redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: for npm run db:migrate (Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: protect /api/setup POST in production
SETUP_SECRET=your_setup_secret

# AI Provider: "qwen" (recommended on Railway), "groq", or "deepseek"
# If QWEN_API_URL is set, Qwen3 is used automatically unless AI_PROVIDER overrides it.
AI_PROVIDER=qwen

# Qwen3 on Railway (OpenAI-compatible /v1/chat/completions)
QWEN_API_URL=https://qwen3-production-d318.up.railway.app/v1
QWEN_API_KEY=                          # optional if your service has no auth
QWEN_MODEL=smollm:135m                 # use qwen2.5:0.5b after upgrading qwen3 RAM

# Fallback providers
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: live web research for university discovery (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
