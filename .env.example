# Site URL — required for auth redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: for npm run db:migrate (Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: protect /api/setup POST in production
SETUP_SECRET=your_setup_secret

# AI Provider: "deepseek" (recommended), "groq", or "qwen"
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional fallbacks
GROQ_API_KEY=your_groq_api_key_here
QWEN_API_URL=
QWEN_MODEL=smollm:135m

# Optional: live web research for university discovery (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
